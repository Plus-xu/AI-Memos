{
  "name": "ai-memos",
  "version": "2026.11.19-1",
  "private": true,
  "description": "Development and packaging tools for the AI-MEMOS browser extension",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm test",
    "package": "pwsh -NoProfile -File scripts/package-extension.ps1",
    "preview": "node scripts/preview-server.cjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mozilla/readability": "0.6.0",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "turndown": "7.2.5",
    "turndown-plugin-gfm": "1.0.2"
  }
}
